<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nb_black"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/overlayImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.85"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/overlayMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GET OUT"
            android:textColor="@color/nb_bright_red"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:shadowColor="#FF0000"
            android:shadowRadius="18"
            android:shadowDx="0"
            android:shadowDy="0" />

        <Button
            android:id="@+id/overlayEscapeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="ESCAPE"
            android:textColor="@color/nb_white"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:backgroundTint="@color/nb_blood"
            android:paddingLeft="32dp"
            android:paddingRight="32dp" />
    </LinearLayout>

</FrameLayout>
